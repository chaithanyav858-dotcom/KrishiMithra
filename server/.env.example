PORT=5000
NODE_ENV=development
JWT_SECRET=krishimitra-mce-cse-mini-project-secret-key-2026
DEMO_MODE=true

# Live Weather Provider (Open-Meteo requires no API key and provides live global forecasts)
WEATHER_PROVIDER=open-meteo

# External Python ML Model Service (optional extension point; if omitted, backend uses the honest agronomy demo predictor)
MODEL_SERVICE_URL=

# Google Cloud Firestore / Firebase Integration (Optional: omit to run in SQLite mode)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY=
